---
/**
 * Row of link tiles for the landing page: a title, one line of description
 * and an arrow. The whole tile is the link.
 *
 *   <LinkTiles columns={4} items={[{ title, description, href }]} />
 *
 * Links starting with `http` open as-is; anything else is treated as a docs
 * path and gets the site base prepended.
 */
const { items = [], columns = 2 } = Astro.props;

const base = import.meta.env.BASE_URL.replace(/\/$/, '');
const tiles = items.map((item) => ({
	...item,
	external: item.href.startsWith('http'),
	href: item.href.startsWith('http') ? item.href : `${base}${item.href}`,
}));
---

<ul class="link-tiles not-content" style={`--columns: ${columns}`}>
	{tiles.map((tile) => (
		<li>
			<a href={tile.href}>
				<span class="link-tiles__title">
					{tile.title}
					<span class="link-tiles__arrow" aria-hidden="true">{tile.external ? '↗' : '→'}</span>
				</span>
				<span class="link-tiles__description">{tile.description}</span>
			</a>
		</li>
	))}
</ul>

<style>
	.link-tiles {
		display: grid;
		grid-template-columns: 1fr;
		gap: 0.75rem;
		margin: 0;
		padding: 0;
		list-style: none;
	}

	@media (min-width: 40rem) {
		.link-tiles {
			grid-template-columns: repeat(2, 1fr);
		}
	}

	@media (min-width: 64rem) {
		.link-tiles {
			grid-template-columns: repeat(var(--columns), 1fr);
		}
	}

	.link-tiles a {
		display: flex;
		flex-direction: column;
		gap: 0.35rem;
		height: 100%;
		padding: 1rem 1.1rem;
		border: 1px solid var(--sl-color-hairline);
		border-radius: 12px;
		background: rgba(255, 255, 255, 0.04);
		text-decoration: none;
		transition: border-color 0.15s ease, background-color 0.15s ease;
	}

	.link-tiles a:hover {
		border-color: var(--sl-color-accent);
		background: rgba(0, 212, 255, 0.07);
	}

	.link-tiles__title {
		display: flex;
		align-items: baseline;
		justify-content: space-between;
		gap: 0.75rem;
		font-size: var(--sl-text-lg);
		font-weight: 600;
		line-height: 1.3;
		color: var(--sl-color-white);
	}

	.link-tiles__arrow {
		color: var(--sl-color-accent);
		transition: transform 0.15s ease;
	}

	.link-tiles a:hover .link-tiles__arrow {
		transform: translateX(3px);
	}

	.link-tiles__description {
		font-size: var(--sl-text-sm);
		line-height: 1.5;
		color: var(--sl-color-gray-2);
	}
</style>
