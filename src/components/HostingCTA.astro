---
/**
 * Hosting call-to-action for docs pages.
 *
 *   <HostingCTA game="project-zomboid" variant="switch" />
 *
 * Every plan fact comes from src/data/plans.js — never hand-write a price,
 * a spec, or a product link into a markdown page. Place the CTA immediately
 * after the final fix step and BEFORE any "Need More Help?" section, so the
 * page resolves the reader's problem first and closes with support options
 * for existing customers.
 *
 * Props:
 *   game     — key in src/data/plans.js (required)
 *   variant  — 'switch' | 'upgrade' | 'start' (default 'start')
 *              switch  → troubleshooting / error pages
 *              upgrade → performance, RAM and save-management pages
 *              start   → getting-started / first-time-setup pages
 *   compact  — one-line version for the TOP of a page. The full block stays
 *              at the bottom; a page can carry both.
 *   tiny     — smallest form: one line of small text with an inline icon and
 *              no box at all, for the very top of a page. Carries no price
 *              and no specs on purpose — it is a signpost, not a pitch.
 *   heading  — optional override for the headline
 *
 * The default slot overrides the hook paragraph, for a page-specific problem:
 *   <HostingCTA game="project-zomboid" variant="switch">
 *     Workshop downloads retry automatically here.
 *   </HostingCTA>
 */
import { plans, formatPrice, REFUND_DAYS } from '../data/plans.js';

const { game, variant = 'start', compact = false, tiny = false, heading } = Astro.props;

const plan = plans[game];
if (!plan) {
	throw new Error(
		`HostingCTA: no plan data for game "${game}". Add it to src/data/plans.js.`
	);
}

const copy = {
	switch: {
		heading: `Hosting ${plan.name} somewhere else?`,
		hook: `We'll migrate your existing world across for free — no downtime, no re-uploading saves.`,
	},
	upgrade: {
		heading: 'Running out of headroom?',
		hook: `Add RAM any time without a restart, and without moving your world.`,
	},
	start: {
		heading: `Want a ${plan.name} server without the setup?`,
		hook: `Your server is online in minutes, managed from the Nitro panel.`,
	},
}[variant];

if (!copy) {
	throw new Error(
		`HostingCTA: unknown variant "${variant}". Use 'switch', 'upgrade' or 'start'.`
	);
}

const specs = `${plan.ram} GB RAM, ${plan.vcpu} vCPU, ${plan.disk} GB NVMe`;
---

{tiny ? (
	<p class="hosting-cta-tiny">
		<a href={plan.url}>
			<svg class="hosting-cta-tiny__icon" viewBox="0 0 16 16" width="14" height="14"
				fill="none" stroke="currentColor" stroke-width="1.4" stroke-linecap="round"
				stroke-linejoin="round" aria-hidden="true">
				<rect x="1.5" y="2" width="13" height="5" rx="1.3" />
				<rect x="1.5" y="9" width="13" height="5" rx="1.3" />
				<path d="M4 4.5h.01M4 11.5h.01" />
			</svg>
			{heading ?? `Need a ${plan.name} server? Spin one up with EVLBOX`}
			<span class="hosting-cta-tiny__arrow"> →</span>
		</a>
	</p>
) : compact ? (
	<a class="hosting-cta hosting-cta--compact" href={plan.url}>
		<strong>{heading ?? `Need a ${plan.name} server?`}</strong> EVLBOX hosts it from{' '}
		<strong>{formatPrice(plan.price)}</strong> — {plan.ram} GB RAM, {plan.slots} slots,
		{' '}{REFUND_DAYS}-day refund guarantee <span class="hosting-cta__arrow">→</span>
	</a>
) : (
<aside class="hosting-cta" aria-label={`${plan.name} hosting`}>
	<p class="hosting-cta__heading">{heading ?? copy.heading}</p>

	<p class="hosting-cta__hook">
		<slot>{copy.hook}</slot>
	</p>

	<p class="hosting-cta__plan">
		{plan.name} servers from <strong>{formatPrice(plan.price)}</strong> ({specs})
		— add RAM any time without a restart, up to {plan.maxRam} GB.
	</p>

	<a class="hosting-cta__link" href={plan.url}>See plans →</a>
</aside>
)}

<style>
	.hosting-cta {
		margin: 2rem 0;
		padding: 1.25rem 1.5rem;
		border: 1px solid var(--sl-color-accent);
		border-left-width: 4px;
		border-radius: 0.5rem;
		background: var(--sl-color-accent-low);
	}

	.hosting-cta__heading {
		margin: 0 0 0.5rem;
		font-weight: 600;
		font-size: var(--sl-text-h5);
		color: var(--sl-color-white);
		line-height: 1.3;
	}

	.hosting-cta p {
		margin: 0 0 0.5rem;
	}

	.hosting-cta__plan {
		font-size: var(--sl-text-sm);
		color: var(--sl-color-gray-2);
	}

	.hosting-cta__plan strong {
		color: var(--sl-color-white);
	}

	.hosting-cta__link {
		display: inline-block;
		font-weight: 600;
		text-decoration: none;
	}

	.hosting-cta__link:hover {
		text-decoration: underline;
	}

	/* One-line version for the top of a page. The whole line is the link, and
	   it stays quieter than the full block so it reads as a signpost rather
	   than an interruption. */
	.hosting-cta--compact {
		display: block;
		margin: 0 0 1.5rem;
		padding: 0.65rem 1rem;
		font-size: var(--sl-text-sm);
		border-width: 1px;
		border-left-width: 3px;
		color: var(--sl-color-gray-2);
		text-decoration: none;
	}

	.hosting-cta--compact strong {
		color: var(--sl-color-white);
	}

	.hosting-cta--compact:hover {
		background: var(--sl-color-accent-low);
		border-color: var(--sl-color-accent-high);
	}

	.hosting-cta--compact:hover strong {
		color: var(--sl-color-accent-high);
	}

	.hosting-cta__arrow {
		color: var(--sl-color-accent-high);
		font-weight: 600;
		white-space: nowrap;
	}

	/* Smallest form: a signpost line above the article body. No box, no
	   background, no border — it should read as a caption, not a banner. */
	.hosting-cta-tiny {
		margin: 0 0 1.25rem;
		font-size: var(--sl-text-xs);
		line-height: 1.4;
	}

	.hosting-cta-tiny a {
		display: inline-flex;
		align-items: center;
		gap: 0.4em;
		color: var(--sl-color-gray-3);
		text-decoration: none;
	}

	.hosting-cta-tiny a:hover {
		color: var(--sl-color-accent-high);
		text-decoration: underline;
	}

	.hosting-cta-tiny__icon {
		flex: none;
		color: var(--sl-color-accent-high);
	}

	.hosting-cta-tiny__arrow {
		color: var(--sl-color-accent-high);
		white-space: nowrap;
	}
</style>
