---
/**
 * Grid of game tiles linking to each game's overview page.
 *
 *   <GameGrid />
 *
 * Used on the docs landing page and on /game-servers/. To add a game, add it
 * to `games` below and drop a 64x64 icon at public/games/<slug>.png. `slug`
 * is the folder name under src/content/docs/game-servers/. The guide count
 * is read from the content collection, so it never needs updating by hand.
 */
import { getCollection } from 'astro:content';

// Keep in alphabetical order, the same as the sidebar.
const games = [
	{ slug: '7-days-to-die', name: '7 Days to Die' },
	{ slug: 'enshrouded', name: 'Enshrouded' },
	{ slug: 'factorio', name: 'Factorio' },
	{ slug: 'foundry', name: 'Foundry' },
	{ slug: 'hytale', name: 'Hytale' },
	{ slug: 'minecraft', name: 'Minecraft' },
	{ slug: 'palworld', name: 'Palworld' },
	{ slug: 'project-zomboid', name: 'Project Zomboid' },
	{ slug: 'satisfactory', name: 'Satisfactory' },
	{ slug: 'sons-of-the-forest', name: 'Sons of the Forest' },
	{ slug: 'starrupture', name: 'StarRupture' },
	{ slug: 'towerunite', name: 'Tower Unite' },
	{ slug: 'valheim', name: 'Valheim' },
	{ slug: 'vintage-story', name: 'Vintage Story' },
	{ slug: 'windrose', name: 'Windrose' },
];

const docs = await getCollection('docs', ({ data }) => !data.draft);
const ids = docs.map((doc) => doc.id);
const base = import.meta.env.BASE_URL.replace(/\/$/, '');

const tiles = games.map((game) => {
	const root = `game-servers/${game.slug}`;
	if (!ids.includes(root)) {
		throw new Error(`GameGrid: no overview page found for "${game.slug}".`);
	}
	const guides = ids.filter((id) => id.startsWith(`${root}/`)).length;
	return {
		...game,
		href: `${base}/${root}/`,
		icon: `${base}/games/${game.slug}.png`,
		count: `${guides} ${guides === 1 ? 'guide' : 'guides'}`,
	};
});
---

<ul class="game-grid not-content">
	{tiles.map((tile) => (
		<li>
			<a href={tile.href}>
				<img src={tile.icon} alt="" width="40" height="40" decoding="async" />
				<span class="game-grid__text">
					<span class="game-grid__name">{tile.name}</span>
					<span class="game-grid__count">{tile.count}</span>
				</span>
			</a>
		</li>
	))}
</ul>

<style>
	.game-grid {
		display: grid;
		grid-template-columns: repeat(2, minmax(0, 1fr));
		gap: 0.75rem;
		margin: 0;
		padding: 0;
		list-style: none;
	}

	@media (min-width: 30rem) {
		.game-grid {
			grid-template-columns: repeat(auto-fill, minmax(12.5rem, 1fr));
		}
	}

	/* On a normal docs page the grid follows a paragraph, so give it room. */
	:global(.sl-markdown-content) > .game-grid {
		margin-top: 1.25rem;
	}

	.game-grid a {
		display: flex;
		align-items: center;
		gap: 0.75rem;
		height: 100%;
		padding: 0.7rem 0.85rem;
		border: 1px solid var(--sl-color-hairline);
		border-radius: 12px;
		background: rgba(255, 255, 255, 0.04);
		text-decoration: none;
		transition: border-color 0.15s ease, background-color 0.15s ease;
	}

	.game-grid a:hover {
		border-color: var(--sl-color-accent);
		background: rgba(0, 212, 255, 0.07);
	}

	.game-grid img {
		flex: none;
		width: 40px;
		height: 40px;
		border-radius: 8px;
		object-fit: cover;
	}

	.game-grid__text {
		display: flex;
		flex-direction: column;
		min-width: 0;
		line-height: 1.3;
	}

	.game-grid__name {
		font-weight: 600;
		color: var(--sl-color-white);
	}

	.game-grid__count {
		font-size: var(--sl-text-xs);
		color: var(--sl-color-gray-3);
	}
</style>
